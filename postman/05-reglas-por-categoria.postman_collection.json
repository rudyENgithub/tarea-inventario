{
  "info": {
    "name": "Inventario · 05 Reglas por categoría",
    "description": "Caso de uso 5 (§5): límite de FLASH_SALE (2 u.), ventanas de 5 min y 24 h, y orden de validación (límite antes que stock).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "mailUrl",
      "value": "http://localhost:8025"
    },
    {
      "key": "S",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Inicializar (sufijo único S)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('S', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"readiness UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health/readiness",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health",
            "readiness"
          ]
        },
        "description": "Genera un sufijo único `S` por ejecución para no chocar con corridas anteriores (un orderId no puede reutilizarse con otros datos)."
      },
      "response": []
    },
    {
      "name": "5.0a Registrar FLASH_SALE",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/FLASH-{{S}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "FLASH-{{S}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"FLASH_SALE\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.0b Registrar PRE_ORDER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/PRE-{{S}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "PRE-{{S}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"PRE_ORDER\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.0c Stock FLASH 10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 10\", function () { pm.expect(pm.response.json().available).to.eql(10); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/FLASH-{{S}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "FLASH-{{S}}",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.0d Stock PRE 10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 10\", function () { pm.expect(pm.response.json().available).to.eql(10); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/PRE-{{S}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "PRE-{{S}}",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.1 FLASH_SALE: 3 u. excede el límite → 422 ORDER_LIMIT_EXCEEDED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
              "pm.test(\"errorCode ORDER_LIMIT_EXCEEDED\", function () { pm.expect(pm.response.json().errorCode).to.eql(\"ORDER_LIMIT_EXCEEDED\"); });",
              "pm.test(\"application/problem+json\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"orderId\":\"F1-{{S}}\",\"sku\":\"FLASH-{{S}}\",\"quantity\":3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.2 FLASH_SALE: 2 u. → 200, expira en ≈ 5 min",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test(\"body has orderId, sku, quantity, expiresAt\", function () { pm.expect(j).to.have.all.keys(\"orderId\", \"sku\", \"quantity\", \"expiresAt\"); });",
              "pm.test(\"expiresAt ≈ ahora + 5 min\", function () { const d = new Date(j.expiresAt).getTime() - Date.now(); pm.expect(d).to.be.within(240000, 305000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"orderId\":\"F2-{{S}}\",\"sku\":\"FLASH-{{S}}\",\"quantity\":2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.3 PRE_ORDER: 8 u. sin límite → 200, expira en ≈ 24 h",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test(\"body has orderId, sku, quantity, expiresAt\", function () { pm.expect(j).to.have.all.keys(\"orderId\", \"sku\", \"quantity\", \"expiresAt\"); });",
              "pm.test(\"expiresAt ≈ ahora + 24 h\", function () { const d = new Date(j.expiresAt).getTime() - Date.now(); pm.expect(d).to.be.within(86340000, 86405000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"orderId\":\"P1-{{S}}\",\"sku\":\"PRE-{{S}}\",\"quantity\":8}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5.4 Límite antes que stock (FLASH, 5 u.) → 422, no 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
              "pm.test(\"errorCode ORDER_LIMIT_EXCEEDED\", function () { pm.expect(pm.response.json().errorCode).to.eql(\"ORDER_LIMIT_EXCEEDED\"); });",
              "pm.test(\"application/problem+json\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); });"
            ]
          }
        }
