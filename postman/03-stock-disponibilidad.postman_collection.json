{
  "info": {
    "name": "Inventario · 03 Alta de stock y disponibilidad",
    "description": "Caso de uso 3 (§3): agregar stock, acumulación, disponibilidad y errores de validación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "mailUrl",
      "value": "http://localhost:8025"
    },
    {
      "key": "S",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Inicializar (sufijo único S)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('S', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"readiness UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health/readiness",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health",
            "readiness"
          ]
        },
        "description": "Genera un sufijo único `S` por ejecución para no chocar con corridas anteriores (un orderId no puede reutilizarse con otros datos)."
      },
      "response": []
    },
    {
      "name": "3.0 Registrar STD",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/STD-{{S}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "STD-{{S}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"STANDARD\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3.1 Producto nuevo tiene 0 disponibles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 0\", function () { pm.expect(pm.response.json().available).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/STD-{{S}}/availability",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "STD-{{S}}",
            "availability"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3.2 Agregar 10 → available 10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 10\", function () { pm.expect(pm.response.json().available).to.eql(10); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/STD-{{S}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "STD-{{S}}",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3.3 Agregar 5 (acumula) → available 15",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 15\", function () { pm.expect(pm.response.json().available).to.eql(15); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/STD-{{S}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "STD-{{S}}",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3.4 SKU desconocido: disponibilidad 0 (nunca error)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 0\", function () { pm.expect(pm.response.json().available).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/NO-EXISTE-{{S}}/availability",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "NO-EXISTE-{{S}}",
            "availability"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3.5 Stock para SKU NO registrado → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"errorCode INVALID_REQUEST\", function () { pm.expect(pm.response.json().errorCode).to.eql(\"INVALID_REQUEST\"); });",
              "pm.test(\"application/problem+json\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/NO-EXISTE-{{S}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "NO-EXISTE-{{S}}",
            "stock"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3.6 Cantidad 0 → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"errorCode INVALID_REQUEST\", function () { pm.expect(pm.response.json().errorCode).to.eql(\"INVALID_REQUEST\"); });",
              "pm.test(\"application/problem+json\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); });"
            ]
          }
        }
