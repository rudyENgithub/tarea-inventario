        "url": {
          "raw": "{{baseUrl}}/api/v1/products/STD-{{S}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "STD-{{S}}",
            "stock"
          ]
        },
