    {
      "name": "10.2c 30 reintentos simultáneos del MISMO pedido → una sola respuesta distinta; se descuenta una vez",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const N = 30;",
              "const codes = {}; const bodies = {}; let finished = 0;",
              "for (let i = 1; i <= N; i++) {",
              "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/v1/reservations', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ orderId: 'SAME-' + pm.variables.get('S'), sku: 'IDEM-' + pm.variables.get('S'), quantity: 3 }) } }, function (e, res) {",
              "    const code = e ? 0 : res.code;",
              "    codes[code] = (codes[code] || 0) + 1;",
              "    if (!e && res.code === 200) { bodies[res.text()] = true; }",
              "    finished++;",
              "    if (finished === N) { pm.collectionVariables.set('idem', JSON.stringify({ codes: codes, distinct: Object.keys(bodies).length })); }",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = JSON.parse(pm.collectionVariables.get('idem'));",
              "pm.test(\"30 × 200\", function () { pm.expect(r.codes[200]).to.eql(30); });",
              "pm.test(\"1 única respuesta distinta\", function () { pm.expect(r.distinct).to.eql(1); });",
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 7\", function () { pm.expect(pm.response.json().available).to.eql(7); });"
            ]
          }
        }
