    {
      "name": "10.1c 200 reservas simultáneas sobre 50 u. → exactamente 50×200 y 150×409",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const N = 200;",
              "const codes = {}; const bodies = {}; let finished = 0;",
              "for (let i = 1; i <= N; i++) {",
              "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/v1/reservations', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ orderId: 'H' + i + '-' + pm.variables.get('S'), sku: 'HOT-' + pm.variables.get('S'), quantity: 1 }) } }, function (e, res) {",
              "    const code = e ? 0 : res.code;",
              "    codes[code] = (codes[code] || 0) + 1;",
              "    if (!e && res.code === 200) { bodies[res.text()] = true; }",
              "    finished++;",
              "    if (finished === N) { pm.collectionVariables.set('hot', JSON.stringify({ codes: codes, distinct: Object.keys(bodies).length })); }",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = JSON.parse(pm.collectionVariables.get('hot'));",
              "pm.test(\"50 × 200\", function () { pm.expect(r.codes[200]).to.eql(50); });",
              "pm.test(\"150 × 409\", function () { pm.expect(r.codes[409]).to.eql(150); });",
              "pm.test(\"ningún 500 / error\", function () { pm.expect(Object.keys(r.codes).sort()).to.eql([\"200\", \"409\"]); });",
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"available = 0\", function () { pm.expect(pm.response.json().available).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/HOT-{{S}}/availability",
          "host": [
