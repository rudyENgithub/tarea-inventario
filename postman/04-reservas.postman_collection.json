    {
      "name": "4.3 Replay idempotente: mismo cuerpo y MISMO expiresAt → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
