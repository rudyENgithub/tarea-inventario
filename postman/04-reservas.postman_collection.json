          "mode": "raw",
          "raw": "{\"quantity\":15}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "4.1 Reservar 3 → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test(\"body has orderId, sku, quantity, expiresAt\", function () { pm.expect(j).to.have.all.keys(\"orderId\", \"sku\", \"quantity\", \"expiresAt\"); });",
              "pm.test(\"expiresAt ≈ ahora + 15 min\", function () { const d = new Date(j.expiresAt).getTime() - Date.now(); pm.expect(d).to.be.within(840000, 905000); });",
              "pm.collectionVariables.set('r1Expires', j.expiresAt);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"orderId\":\"R1-{{S}}\",\"sku\":\"STD-{{S}}\",\"quantity\":3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
