<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Expected failures injected by tests would otherwise flood the build output. -->
    <logger name="com.store.inventory.adapter.out.notification.SafeStockAlertListener" level="OFF"/>
    <logger name="com.store.inventory.application.alert" level="OFF"/>
    <logger name="com.store.inventory.application.DefaultInventoryService" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
